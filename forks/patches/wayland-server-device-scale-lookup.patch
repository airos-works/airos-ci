 // The buffer scale clients should draw at: on a scaled desktop (air/OS,
 // BScreen::DeviceScale(), looked up at run time) its device scale rounded up.
 // Surfaces drawn at a higher density than the desktop are filtered down.
+typedef float (*DeviceScaleFunction)(BScreen *screen);
+
+// Looked up in libbe's own image: a client that does not link libbe itself
+// (GTK) loads it only as a dependency of this add-on, where
+// dlsym(RTLD_DEFAULT) does not find it.
+static DeviceScaleFunction FindDeviceScale()
+{
+	image_info info;
+	int32 cookie = 0;
+	while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) == B_OK) {
+		const char *name = strrchr(info.name, '/');
+		name = name != NULL ? name + 1 : info.name;
+		if (strcmp(name, "libbe.so") != 0) continue;
+		void *symbol;
+		if (get_image_symbol(info.id, "_ZN7BScreen11DeviceScaleEv", B_SYMBOL_TYPE_TEXT, &symbol) != B_OK)
+			return NULL;
+		return (DeviceScaleFunction)symbol;
+	}
+	return NULL;
+}
+
