diff --git a/configure.py b/configure.py
index 95bd8bc3..a955740d 100755
--- a/configure.py
+++ b/configure.py
@@ -2333,6 +2333,19 @@ if 'make_global_settings' in output:
 else:
   make_global_settings = False
 
+# air/OS: in a cross build for Haiku, the libraries and headers found above are
+# the target's. The host tools (node_js2c) link the host build of libuv in
+# HOST_LIBUV_PREFIX instead.
+if options.cross_compiling and options.dest_os == 'haiku':
+  target_only = {k: output.pop(k) for k in ('libraries', 'include_dirs') if k in output}
+  host_libuv = os.environ.get('HOST_LIBUV_PREFIX')
+  host_only = {}
+  if host_libuv:
+    host_only = {'include_dirs': [host_libuv + '/include'],
+                 'libraries': [host_libuv + '/lib/libuv.a', '-lpthread', '-ldl']}
+  output['target_conditions'] = [['_toolset=="target"', target_only],
+                                 ['_toolset=="host"', host_only]]
+
 # Add configurations to target defaults
 output['configurations'] = configurations
 
